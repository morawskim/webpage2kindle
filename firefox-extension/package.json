{
  "scripts": {
    "build": "webpack --config webpack-web-extension.config.mjs",
    "start:firefox": "web-ext run  --source-dir ./dist/ --browser-console --arg='--remote-debugging-port=9222'",
    "start:chrome": "web-ext run --verbose -t chromium --chromium-binary=/usr/bin/google-chrome --source-dir ./dist/",
    "sign": "web-ext sign"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@types/node": "^26.6.4",
    "@types/webextension-polyfill": "^0.12.6",
    "copy-webpack-plugin": "^14.0.0",
    "puppeteer-core": "^25.12.0",
    "swc-loader": "^0.2.7",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "web-ext": "^10.7.0",
    "web-ext-plugin": "^2.13.0",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
